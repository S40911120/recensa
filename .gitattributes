# Normalize line endings to LF on check-in; check out native.
# Keeps cross-platform PRs from producing whole-file diffs out of CRLF/LF churn.
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.db   binary
