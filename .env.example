# Recensa docker-compose environment — copy to `.env` and adjust.
#
# CLAUDE_HOME: absolute path to the host ~/.claude dir (its projects/ subdir holds the
# session JSONL). Read-only bind-mounted into the container at /data/claude.
#   Linux/Mac : usually /home/you/.claude  or  /Users/you/.claude
#   Windows   : C:/Users/you/.claude   (forward slashes; MUST be set — compose's
#               ${HOME} fallback is often unset under PowerShell/cmd → empty mount)
CLAUDE_HOME=/absolute/path/to/your/.claude

# RECENSA_HOST_PORT: host-side published port (container listens on 7788 internally).
# Override only if 7788 is already taken on the host (e.g. a native install running alongside).
# RECENSA_HOST_PORT=7788
